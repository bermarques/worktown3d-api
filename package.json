{
  "name": "worktown3d-api",
  "version": "0.2.0",
  "description": "API for Worktown3D: GitHub data, sign-in, building settings and subscriptions.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/main.js",
    "demo": "node dist/main.js --demo",
    "dev": "tsc-watch --onSuccess \"node dist/main.js\"",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:dev": "prisma migrate dev",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "express": "^5.2.1",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsc-watch": "^7.2.1",
    "typescript": "~6.0.3"
  }
}
